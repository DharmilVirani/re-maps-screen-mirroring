  "integration_contracts": [
    {
      "id": "contract:renderer-to-encoder",
      "from": "TripperMapRenderer",
      "to": "H264Encoder",
      "message": "start(encoderSurface), update(TftRenderState), zoomBy(delta), recenter(), close()",
      "threading": "Presentation and MapLibre lifecycle on main thread; encoder output on codec callback thread",
      "error_behavior": "Fail session visibly and release Presentation, VirtualDisplay, encoder and Surface."
    },
    {
      "id": "contract:ride-to-tripper",
      "from": "RideSessionService",
      "to": "TripperSession/TripperTransport",
      "message": "Connect over selected Network, authenticate, begin projection, send encoded frames and receive control packets",
      "threading": "Service lifecycle on main thread; blocking UDP and protocol work on owned worker executor",
      "error_behavior": "Bound reconnect attempts; report stage and clean up sockets, callbacks and locks."
    },
    {
      "id": "contract:ride-to-location",
      "from": "RideSessionService",
      "to": "PhoneLocationSource/RouteProgressTracker",
      "message": "Start GPS only after explicit Ride start; publish current progress and guarded ETA",
      "threading": "Location callbacks feed domain state; renderer updates marshalled to main thread",
      "error_behavior": "Show no-GPS/stale/off-route state and omit ungrounded ETA."
    },
    {
      "id": "contract:map-pack",
      "from": "MapPackRepository",
      "to": "MapLibre offline API/OpenFreeMap",
      "message": "Prepare one route-bound offline region with identifying User-Agent, concurrency and provider caps",
      "threading": "Provider downloads run outside the active bike network session",
      "error_behavior": "Cancel and delete incomplete over-cap packs; never split downloads to evade limits."
    }
  ],
  "replan_triggers": [
    "Presentation/VirtualDisplay does not deliver continuous app-owned frames to the encoder on the target phone.",
    "MapLibre offline APIs cannot enforce the current provider cap before it is exceeded.",
    "OpenFreeMap terms, availability, style or coverage no longer support the intended use.",
    "Tripper FOTA 11.63 rejects the retained K1G handshake or H.264/RTP profile.",
    "Joystick events conflict with observed target-bike behavior.",
    "Android changes alter foreground location, connected-device service, Wi-Fi binding or screen-off behavior."
  ]
}
